# Optional: set your own JWT secret.
# If not set, one is auto-generated on first run and saved to the data volume.
# Generate one with: openssl rand -hex 32
# LOCUS_JWT_SECRET=your-secret-here

# Public URL used by SvelteKit to validate form submissions in production.
# Change this to the device's LAN URL when opening Locus Vision from another machine.
# ORIGIN=http://192.168.1.50:3000

# Internal backend URL used by the SvelteKit server (normally unchanged).
# LOCUS_API_URL=http://127.0.0.1:8000

# For custom public hostnames, provide either a JSON list or an anchored regex.
# LOCUS_CORS_ORIGINS=["https://vision.example.com"]
# LOCUS_CORS_ORIGIN_REGEX=^https://vision\.example\.com$
